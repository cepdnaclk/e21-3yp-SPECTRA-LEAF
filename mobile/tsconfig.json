{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "src/legacy-next-app/**/*",
    "src/components/charts/**/*",
    "src/components/layout/**/*",
    "src/hooks/useAuth.ts",
    "src/middleware.ts"
  ]
}
