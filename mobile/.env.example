# Public/shared APK build
# Use an HTTPS backend URL that your friend's phone can reach.
# The app accepts either the backend origin or the /api URL.
EXPO_PUBLIC_API_BASE_URL=https://your-public-backend.example.com/api

# Android emulator only
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5000/api

# Real phone on the same Wi-Fi only
# EXPO_PUBLIC_API_BASE_URL=http://10.208.226.39:5000/api
