# Web / iOS simulator on the same computer
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Android emulator
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5000/api

# Real phone (replace with your computer's LAN IP)
# Current detected Wi-Fi IP example:
# EXPO_PUBLIC_API_BASE_URL=http://10.200.113.39:5000/api

# Optional local preview credentials for native app builds
EXPO_PUBLIC_DEFAULT_LOGIN_EMAIL=officer@spectraleaf.local
EXPO_PUBLIC_DEFAULT_LOGIN_PASSWORD=change-me
